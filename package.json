{
  "name": "cwt",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Browser CW keying trainer: record, decode, and grade your sending.",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:device": "node scripts/devcert.mjs && vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project pure --project dom",
    "test:watch": "vitest --project pure --project dom",
    "test:pure": "vitest run --project pure",
    "test:dom": "vitest run --project dom",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "lock": "LOCK_RECORD=1 vitest run --project pure clean-path",
    "bump": "node scripts/version.mjs --commit --branch \"$(git rev-parse --abbrev-ref HEAD)\"",
    "bump:dry": "node scripts/version.mjs --dry-run --branch \"$(git rev-parse --abbrev-ref HEAD)\""
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.50.0",
    "typescript": "^6.0.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
