{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vitest/globals", "node", "vite/client"],

    /* The point of adopting TypeScript here is that the data shapes are
       checked, so none of this is negotiable per-file. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* For scripts/version.mjs. It is plain JS so that `node scripts/version.mjs`
       needs no build step at all — a release tool that has to be compiled
       before it can bump a version is a release tool with a bootstrapping
       problem. checkJs is what keeps that from being an escape hatch: its
       JSDoc types are checked under the same strictness as everything else. */
    "allowJs": true,
    "checkJs": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "paths": {
      "@/*": ["./app/src/*"]
    }
  },
  "include": ["app/src", "app/test", "scripts", "vite.config.ts"]
}
